{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "automationDetails": {
        "id": "eal-DEMO-NORMALIZED"
      },
      "tool": {
        "driver": {
          "name": "engineering-assurance-layer",
          "version": "0.0.2",
          "rules": [
            {
              "id": "NAV2_ACCEL_OVERDECLARED",
              "name": "NAV2_ACCEL_OVERDECLARED",
              "shortDescription": {
                "text": "Controller declares linear acceleration limit 1.20x the downstream smoother limit"
              },
              "fullDescription": {
                "text": "Controller `ax_max` = 3.0 m/s^2 (controller_server.ros__parameters.FollowPath.ax_max); downstream velocity_smoother `max_accel[0]` = 2.5 m/s^2 (velocity_smoother.ros__parameters.max_accel[0]). The controller's figure exceeds the smoother's by 1.20x, and the smoother is what the base actually receives."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "properties": {
            "analysisStatus": "INPUTS_FULLY_READ",
            "coverageGapCount": 0,
            "uncheckedHazards": {
              "statement": "Hazard classes EAL does not check. A review that reports no findings says nothing about any of these. Measured by the adversarial evaluation in eval/, not asserted.",
              "measured": {
                "hazardous_mutations": 19,
                "detected": 8,
                "undetected": 11,
                "source": "eval/output/results.json"
              },
              "class_count": 8,
              "classes": [
                {
                  "id": "conflicting_definitions",
                  "title": "Contradictory definitions in unexamined locations",
                  "worst_hazard": "moderate",
                  "detail": "Duplicate keys in one mapping are detected. A second controller plugin block with contradictory limits is not: the importer resolves the first plugin entry and never inspects alternatives.",
                  "evidence": [
                    "M16"
                  ]
                },
                {
                  "id": "false_safety_assumption",
                  "title": "Physically implausible declared capability",
                  "worst_hazard": "severe",
                  "detail": "EAL checks that declarations agree with each other, never that any of them is achievable. A platform declaring roughly ten g of braking, or zero actuation delay alongside a half-second control loop, is accepted without comment.",
                  "evidence": [
                    "M22",
                    "M23"
                  ]
                },
                {
                  "id": "latency_increase",
                  "title": "Slower control or perception loop",
                  "worst_hazard": "severe",
                  "detail": "Control frequency, costmap update rate, transform tolerance, and source timeouts are extracted as timing parameters but are never related to the speed the robot is permitted to travel. Sensor and actuator latency are absent from Nav2 configuration entirely and are not modelled at all.",
                  "evidence": [
                    "M07",
                    "M08"
                  ]
                },
                {
                  "id": "max_speed_increase",
                  "title": "Speed raised within an internally consistent configuration",
                  "worst_hazard": "severe",
                  "detail": "EAL compares the controller's declared limits against the downstream clamp. A speed increase applied to both keeps them in agreement and is not examined. Nothing relates speed to braking capability, sensor range, or stopping distance.",
                  "evidence": [
                    "M03"
                  ]
                },
                {
                  "id": "min_decel_reduction",
                  "title": "Weakened braking within an internally consistent configuration",
                  "worst_hazard": "severe",
                  "detail": "As with speed: a deceleration limit lowered on both the controller and the smoother keeps them in agreement. Stopping distance is not modelled, so a coherent reduction in braking authority is invisible.",
                  "evidence": [
                    "M10"
                  ]
                },
                {
                  "id": "missing_parameter",
                  "title": "An entire configuration section absent",
                  "worst_hazard": "moderate",
                  "detail": "A missing individual limit is reported as an incomplete comparison. A missing whole section, such as no velocity smoother at all, is treated as the check being inapplicable rather than unknown. That judgement is arguable and is recorded here so it stays visible.",
                  "evidence": [
                    "M14"
                  ]
                },
                {
                  "id": "stopping_region_reduction",
                  "title": "Reduced sensing range or clearance margin",
                  "worst_hazard": "severe",
                  "detail": "Sensor marking range, raytrace range, and inflation radius are extracted but no check consumes them. A robot configured so that it cannot detect an obstacle in time to stop produces no finding.",
                  "evidence": [
                    "M05",
                    "M06"
                  ]
                },
                {
                  "id": "unit_mismatch",
                  "title": "Unit errors applied consistently",
                  "worst_hazard": "moderate",
                  "detail": "A unit conversion mistake made on both sides of a comparison is arithmetically coherent. EAL has no notion of a plausible magnitude for a physical quantity, so it cannot tell metres from feet or radians from degrees.",
                  "evidence": [
                    "M12"
                  ]
                }
              ]
            }
          }
        }
      ],
      "results": [
        {
          "ruleId": "NAV2_ACCEL_OVERDECLARED",
          "level": "error",
          "message": {
            "text": "Controller declares linear acceleration limit 1.20x the downstream smoother limit Controller `ax_max` = 3.0 m/s^2 (controller_server.ros__parameters.FollowPath.ax_max); downstream velocity_smoother `max_accel[0]` = 2.5 m/s^2 (velocity_smoother.ros__parameters.max_accel[0]). The controller's figure exceeds the smoother's by 1.20x, and the smoother is what the base actually receives. The velocity_smoother expresses the platform's hard limits; the controller expresses what it would like to do, which may legitimately be less. Declaring more than the hard limit inverts that relationship: the controller is planning with capability the platform is not configured to deliver. The two are intended to be set independently, with the controller permitted to sit below the platform's hard limit \u2014 but not above it. Nav2 maintainer, ros-navigation/navigation2#6357 (2026-08-14): \"they are intended to be differently defined such that there can be different limits in different situations... The velocity smoother is more enforcing hard limitations than behavioral desires that a controller may compute as part of what it would like to do.\" Asked about this exact pair of defaults in nav2_params.yaml, the same maintainer replied that the mismatch is \"odd and unintentional\". EAL still reports the values and the direction rather than ruling on your configuration; your stack may have a reason. But over-declaration is not the intended use of this pair."
          },
          "properties": {
            "ealFindingId": "F-001",
            "severity": "HIGH",
            "related_ir_nodes": [
              "NAV2-CONTROLLER_A_ACCEL_LINEAR",
              "NAV2-SMOOTHER_A_ACCEL_LINEAR"
            ],
            "evidence_refs": [
              "nav2_plugin:nav2_mppi_controller::MPPIController"
            ],
            "source_refs": [
              "tests/fixtures/nav2_upstream_params/nav2_params.yaml:controller_server.ros__parameters.FollowPath.ax_max",
              "tests/fixtures/nav2_upstream_params/nav2_params.yaml:velocity_smoother.ros__parameters.max_accel[0]"
            ]
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures/nav2_upstream_params/nav2_params.yaml"
                }
              }
            }
